{
  "name": "daily-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "nodemailer": "^8.0.11",
    "nodemon": "^3.1.14"
  }
}
